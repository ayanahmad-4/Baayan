# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# Required: Your Groq API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use (default shown below)
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Path to resume PDF (relative to project root or absolute)
RESUME_PATH=back-end/data/resume.pdf

# Optional: Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.netlify.app

# Optional: Rate limiting (requests per IP per minute)
RATE_LIMIT_REQUESTS=30
